<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>codegraph-mcp</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CodeGraph.Core/CodeGraph.Core.csproj" />
  </ItemGroup>
  <!-- Copy the shared web UI from the Web project before C# compilation. -->
  <Target Name="CopyWebUI" BeforeTargets="CoreCompile;PrepareForBuild">
    <MakeDir Directories="wwwroot" />
    <Copy SourceFiles="../CodeGraph.Web/wwwroot/index.html"
          DestinationFiles="wwwroot/index.html"
          SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot/index.html" />
  </ItemGroup>
</Project>
