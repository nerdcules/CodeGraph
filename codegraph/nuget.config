<?xml version="1.0" encoding="utf-8"?>
<!--
  Pins restore to nuget.org regardless of machine-level or user-level feeds, so a build is the same on
  every developer machine and in CI. <clear /> drops any inherited source, and the source mapping below
  means a package can only ever come from here: a private feed that happens to publish a same-named
  package cannot be substituted in (dependency confusion).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <!-- Audit on restore is what TreatWarningsAsErrors promotes to a build break (see README, Build). -->
    <add key="NuGetAudit" value="true" />
    <add key="NuGetAuditLevel" value="low" />
    <add key="NuGetAuditMode" value="all" />
  </config>
</configuration>
